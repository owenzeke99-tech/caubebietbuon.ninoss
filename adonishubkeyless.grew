-- Adonis Hub - Modern Dark Key System (Updated Link & UI)
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

-- Xóa giao diện cũ nếu đã tồn tại
if CoreGui:FindFirstChild("AdonisHubKeyUI") then
    CoreGui.AdonisHubKeyUI:Destroy()
end

-- Cấu hình hệ thống
local CONFIG = {
    CorrectKey = "AdonisHubKeyBskwiwjwoOaowiwkwoLsjwjwowo",
    ScriptURL = "https://raw.githubusercontent.com/caubebietbuon/Misozz/main/Adonis.lua",
    GetKeyURL = "https://link4m.net/A7MriIMy", -- Link Get Key mới của bạn
    SaveFileName = "AdonisHub_KeyData.txt",
    ExpireSeconds = 86400 -- 24 giờ lưu ẩn
}

-- Kiểm tra lưu key ẩn
local function CheckSavedKey()
    if isfile and readfile and isfile(CONFIG.SaveFileName) then
        local success, content = pcall(function()
            return readfile(CONFIG.SaveFileName)
        end)
        if success and content then
            local savedKey, savedTime = content:match("^(.-)|(%d+)$")
            if savedKey == CONFIG.CorrectKey and savedTime then
                if os.time() - tonumber(savedTime) < CONFIG.ExpireSeconds then
                    return true
                end
            end
        end
    end
    return false
end

local function SaveKeyData()
    if writefile then
        pcall(function()
            writefile(CONFIG.SaveFileName, CONFIG.CorrectKey .. "|" .. tostring(os.time()))
        end)
    end
end

local function LoadMainScript()
    local success, err = pcall(function()
        loadstring(game:HttpGet(CONFIG.ScriptURL))()
    end)
    if not success then
        warn("[Adonis Hub] Script Load Error: " .. tostring(err))
    end
end

if CheckSavedKey() then
    LoadMainScript()
    return
end

