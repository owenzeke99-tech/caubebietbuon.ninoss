-- Kéo thả menu
local dragging, dragInput, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)
MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Hiệu ứng lắc khung cực gắt + đổi viền đỏ rực khi sai key
local isShaking = false
local function SmoothShake()
    if isShaking then return end
    isShaking = true
    
    local basePos = MainFrame.Position
    local offsets = {-16, 16, -11, 11, -7, 7, -3, 3, 0}
    local stepTime = 0.025
    
    TweenService:Create(InputStroke, TweenInfo.new(0.05), {Color = Color3.fromRGB(255, 45, 45)}):Play()
    TweenService:Create(MainStroke, TweenInfo.new(0.05), {Color = Color3.fromRGB(255, 45, 45)}):Play()
    
    for _, offset in ipairs(offsets) do
        TweenService:Create(
            MainFrame,
            TweenInfo.new(stepTime, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
            {Position = UDim2.new(basePos.X.Scale, basePos.X.Offset + offset, basePos.Y.Scale, basePos.Y.Offset)}
        ):Play()
        task.wait(stepTime)
    end
    
    task.delay(0.5, function()
        TweenService:Create(InputStroke, TweenInfo.new(0.4), {Color = Color3.fromRGB(45, 45, 52)}):Play()
        TweenService:Create(MainStroke, TweenInfo.new(0.4), {Color = Color3.fromRGB(55, 55, 62)}):Play()
    end)
    
    isShaking = false
end

-- Xử lý nút Get Key (Copy Link4m vào clipboard & thông báo)
GetKeyBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(CONFIG.GetKeyURL)
        ShowStatus("✦ Copied Get Key Link to Clipboard!", Color3.fromRGB(130, 210, 255), Color3.fromRGB(20, 35, 50), Color3.fromRGB(50, 120, 180))
    else
        ShowStatus("⚠ Clipboard not supported!", Color3.fromRGB(255, 180, 80), Color3.fromRGB(45, 35, 20), Color3.fromRGB(180, 120, 50))
    end
end)

-- Xử lý nút Verify Key
VerifyBtn.MouseButton1Click:Connect(function()
    local enteredKey = KeyBox.Text:gsub("%s+", "")
    
    if enteredKey == CONFIG.CorrectKey then
        SaveKeyData()
        ShowStatus("✓ Access Granted! Launching...", Color3.fromRGB(90, 250, 140), Color3.fromRGB(20, 45, 30), Color3.fromRGB(50, 180, 90))
        TweenService:Create(InputStroke, TweenInfo.new(0.25), {Color = Color3.fromRGB(90, 250, 140)}):Play()
        
        task.wait(0.7)
        TweenService:Create(MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1
        }):Play()
        task.wait(0.37)
        ScreenGui:Destroy()
        LoadMainScript()
    else
        ShowStatus("✕ Invalid Key! Access Denied.", Color3.fromRGB(255, 90, 90), Color3.fromRGB(45, 20, 20), Color3.fromRGB(180, 50, 50))
        KeyBox.Text = ""
        task.spawn(SmoothShake)
    end
end)

