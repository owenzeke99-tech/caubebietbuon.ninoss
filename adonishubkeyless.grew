StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
StatusLabel.TextSize = 11
StatusLabel.TextTransparency = 1
StatusLabel.TextXAlignment = Enum.TextXAlignment.Center

local function ShowStatus(text, textColor, badgeBg, badgeBorder)
    StatusBadge.Visible = true
    StatusBadge.BackgroundColor3 = badgeBg or Color3.fromRGB(30, 30, 38)
    BadgeStroke.Color = badgeBorder or Color3.fromRGB(60, 60, 70)
    StatusLabel.Text = text
    StatusLabel.TextColor3 = textColor
    
    StatusBadge.Size = UDim2.new(0.80, 0, 0, 0)
    StatusBadge.BackgroundTransparency = 1
    BadgeStroke.Transparency = 1
    StatusLabel.TextTransparency = 1
    
    TweenService:Create(StatusBadge, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0.84, 0, 0, 24),
        BackgroundTransparency = 0.15
    }):Play()
    
    TweenService:Create(BadgeStroke, TweenInfo.new(0.2), {Transparency = 0.3}):Play()
    TweenService:Create(StatusLabel, TweenInfo.new(0.2), {TextTransparency = 0}):Play()
end

